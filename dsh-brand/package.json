{
  "name": "@openlegal/dsh-client-ui-brand-legal",
  "version": "0.1.0",
  "description": "Marca de Open Legal Harness: la balanza y el nombre del producto en el sidebar y en el héroe de la conversación de DeepSeek Harness",
  "type": "module",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/verificar-artefacto.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
